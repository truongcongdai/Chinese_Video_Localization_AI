# .env.example
# Application
APP_NAME=chinese-video-localization-ai
ENVIRONMENT=production
LOG_LEVEL=INFO

# Database (local defaults; Docker Compose overrides these paths)
DATABASE_PATH=./local_data/database.sqlite3
WEB_DB_PATH=./local_data/database.sqlite3

# Redis
# Optional locally; the cache falls back to in-process memory when unavailable.
REDIS_URL=redis://127.0.0.1:6379/0

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_IDS=123456789,987654321

# Admin API
ADMIN_API_TOKEN=your_admin_api_token_here

# Media Directories
TEMP_DIR=./local_data/temp
OUTPUT_DIR=./local_data/output
LOGS_DIR=./local_data/logs

# Speech Recognition
SPEECH_LANGUAGE=zh  # Chinese
SPEECH_MODEL=base   # tiny, base, small, medium, large

# Translation
TRANSLATION_PROVIDER=noop  # noop, google, deepl

# TTS
TTS_LANGUAGE=vi  # Vietnamese
TTS_PROVIDER=edgetts  # edgetts, noop

# Rendering
RENDER_ENABLED=true
RENDER_QUALITY=high  # low, medium, high
WEB_RENDER_PRESET=fast
WEB_RENDER_TIMEOUT_SECONDS=1800

# AI video creator stock footage. Add at least one key to let "Tạo video AI"
# pull real images/videos instead of using fallback generated backgrounds.
PEXELS_API_KEY=NLHvJDc5gi9kT5CWVECdGRX99Cgka8xBrLEyfeYOzBNVFbLaor0HLitv
PIXABAY_API_KEY=56787905-c7e4b652d505758151e44b75e

# AI-assisted SEO keywords, visual brief and narration. "auto" tries local
# Ollama first, then OpenRouter Free, then Gemini. Use "ollama" for zero API cost.
CREATOR_AI_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_STORYBOARD_TIMEOUT=60
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# "AI Sinh Ảnh" automatically uses NVIDIA CUDA when available, otherwise CPU.
# Set IMAGE_AI_DEVICE=cpu/cuda to force a device instead of auto-detection.
IMAGE_AI_DEVICE=auto
IMAGE_AI_MODEL=stabilityai/sd-turbo
IMAGE_AI_STEPS=1

# True image-to-video generation. This option requires an NVIDIA CUDA GPU.
# The first job downloads the LTX model. CPU offload lowers VRAM use at the
# cost of speed; set false on a server with plenty of VRAM.
LTX_VIDEO_MODEL=Lightricks/LTX-Video-0.9.5
LTX_VIDEO_STEPS=30
LTX_VIDEO_FPS=24
LTX_VIDEO_MAX_FRAMES=49
LTX_VIDEO_CPU_OFFLOAD=true

# Bank transfer / VietQR shown in the token top-up dialog.
PAYMENT_BANK_ID=BIDV
PAYMENT_BANK_NAME=BIDV
PAYMENT_ACCOUNT_NUMBER=123456
PAYMENT_ACCOUNT_NAME=TRUONG CONG DAI
# Optional: use a custom static QR instead of the generated VietQR image.
PAYMENT_QR_URL=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_ENABLED=true

# Performance
MAX_WORKERS=4
ENABLE_DEMUCS=false  # Disabled by default (GPU intensive)

# Webhook
WEBHOOK_URL=your_webhook_url_here
WEBHOOK_ENABLED=false
# Web UI (scripts/run_web.py / docker-compose.prod.yml "web" service)
# REQUIRED for login sessions to be signed — the web app raises an error on
# login/register without it. Generate with: openssl rand -hex 32
WEB_SESSION_SECRET=your_random_hex_secret_here

# Credits charged per submitted job (usage limiting only, no billing
# wired up). Admin tops up individual users from the admin dashboard.
# Set to 0 to disable the credits gate entirely.
JOB_COST_CREDITS=1

# Whether anyone can self-register (email/phone/Google/GitHub/Facebook) at
# any time. The very first account ever created is always the admin
# regardless of this setting. Set to false to go back to "admin creates
# every account by hand from the admin dashboard".
OPEN_REGISTRATION=true

# ---- "Sign in with ..." login/registration (separate from the "Connect my
# account to publish videos" OAuth further below — this one is just about
# who you are, not about posting on your behalf). Google and Facebook can
# reuse the SAME client id/secret as the publish-OAuth section below (one
# Google Cloud OAuth Client / one Meta app can serve both); you only need
# to additionally add this flow's own redirect URI to that same app:
#   <your server URL>/api/identity/callback/google
#   <your server URL>/api/identity/callback/facebook
# GitHub is login-only in this app (nothing here publishes to GitHub), so
# it needs its own app — github.com/settings/developers -> New OAuth App
# -> Authorization callback URL = <your server URL>/api/identity/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Social "Connect" OAuth apps (one app per platform, shared by ALL
# users of this server — each user then clicks "Connect" in the UI and
# authorizes with THEIR OWN account; only the app registration itself is
# shared, not the resulting per-user tokens, which live in the database). ----

# YouTube — Google Cloud Console -> new project -> enable "YouTube Data
# API v3" -> OAuth consent screen -> Credentials -> OAuth client ID
# (type: Web application) -> add an Authorized redirect URI of
# "<your server URL>/api/social/callback/youtube" (e.g.
# http://127.0.0.1:8080/api/social/callback/youtube while testing locally).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook — developers.facebook.com -> Create App (type: Business) ->
# add product "Facebook Login" -> Settings -> add a Valid OAuth Redirect
# URI of "<your server URL>/api/social/callback/facebook". Posting to a
# real (non-test) Page additionally needs Meta App Review approval for
# the pages_manage_posts permission, and a Meta Business account
# (free, create one at business.facebook.com) to submit for review.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# TikTok — developers.tiktok.com -> Manage apps -> Create app -> add
# products "Login Kit" and "Content Posting API" -> set the Redirect URI
# to "<your server URL>/api/social/callback/tiktok". Until TikTok audits
# the app, Content Posting API can only publish to your own added test
# accounts (not arbitrary users).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Multi-user/SaaS mode (recommended): keep this false. Every user must connect
# their own social account; the client ID/secret above identifies this app,
# while each user's access/refresh tokens are stored under their own user_id.
ALLOW_SHARED_SOCIAL_CREDENTIALS=false

# ---- Optional: old single-shared-account mode (back-compat only) ----
# These values are ignored unless ALLOW_SHARED_SOCIAL_CREDENTIALS=true.
# Never enable this on a client-facing, multi-user server.
TIKTOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
